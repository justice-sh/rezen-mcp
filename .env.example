# Copy to .env for local development. Never commit .env or real values.
#
# How configuration loads (src/config):
#   1. .env
#   2. .env.<NODE_ENV>   optional; put only the values that differ (for example .env.test)
#   3. real environment variables always win (CI, a hosting platform, your shell)
# NODE_ENV defaults to "development". `pnpm test` sets it to "test".
# An empty value counts as unset.
#
# Variables not listed in src/config/schema.ts (such as PORT) are not read by
# the app yet; each is declared there by the slice that starts using it.

# Postgres. One URL, whichever provider runs the server.
# docker (default): `pnpm db:up` starts it with docker-compose.yml (port 15432).
DATABASE_URL=postgresql://rezen:rezen@localhost:15432/rezen_mcp
DB_PROVIDER=docker
# local: a Postgres installed on this machine, no Docker needed. For example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rezen_mcp
# DB_PROVIDER=local
# Check which one the app uses and whether it answers: `pnpm db:check`.

# Phase 4+ (HTTP transport). Not read yet.
PORT=3000
