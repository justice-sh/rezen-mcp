# Copy to .env for local development. Never commit .env or real values.
#
# How configuration loads (src/config):
#   1. .env
#   2. .env.<NODE_ENV>   optional; put only the values that differ (for example .env.test)
#   3. real environment variables always win (CI, a hosting platform, your shell)
# NODE_ENV defaults to "development". `pnpm test` sets it to "test".
# An empty value counts as unset.
#
# The variables below are not read by the app yet. Each one is declared in
# src/config/schema.ts by the slice that starts using it.

# Phase 2+ (Postgres). Placeholders only.
DATABASE_URL=postgresql://user:password@localhost:5432/rezen_mcp
# Phase 4+ (HTTP transport)
PORT=3000
